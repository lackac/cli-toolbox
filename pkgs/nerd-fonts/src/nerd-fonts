glyphs_url="https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/glyphnames.json"
glyphs_file="${XDG_CACHE_HOME:-$HOME/.cache}/nerd-fonts/glyphnames.json"

fetch_glyphs() {
  mkdir -p "$(dirname "$glyphs_file")"
  curl -fsSL -o "$glyphs_file" "$glyphs_url"
}

if [[ ${1:-} = "--refresh" ]]; then
  fetch_glyphs
  shift
fi

if [[ ! -f $glyphs_file ]]; then
  fetch_glyphs
fi

list_chars() {
  jq -r 'to_entries[]
    | select(.key != "METADATA")
    | (.key | split("-")) as $parts
    | "\(.value.char)\t\($parts[0])\t\($parts[1:] | join("-"))"' "$glyphs_file"
}

if [[ ${1:-} = "-f" ]]; then
  fzf_opts=(-i --delimiter '\t' --nth -1)
  if [[ -n ${2:-} ]]; then
    fzf_opts+=(--filter "$2")
  fi

  list_chars | fzf "${fzf_opts[@]}"
else
  list_chars
fi
